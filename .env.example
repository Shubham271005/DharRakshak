# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
#   cp .env.example .env

# Groq — chatbot LLM + Whisper speech-to-text. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3

# Image model (see backend/ml/classifier.py → MODELS; docs/MODEL_CARD.md)
# DHARRAKSHAK_MODEL=linkanjarad-mobilenetv2     # best real-world accuracy (license not stated)
# DHARRAKSHAK_MODEL=dinov2-small                 # CC-BY-SA-4.0
# DHARRAKSHAK_MODEL=convnext-tiny                # Apache-2.0
