# Used by `npm run build` (Vercel). Not secret.
# The backend runs on Render (render.yaml). If Render gives your service a
# different address, set VITE_API_BASE in Vercel → Project → Settings →
# Environment Variables (that overrides this file), then redeploy.
VITE_API_MODE=api
VITE_API_BASE=https://dharrakshak-api.onrender.com
