# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
#   cp .env.example .env
#
# Every variable below is optional except GROQ_API_KEY: without it the app
# still runs, but the chatbot answers from saved text and voice input is off.
# Values already exported in your shell WIN over this file.

# ---------------------------------------------------------------------------
# Groq — chatbot LLM + Whisper speech-to-text. Get a key: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Optional model overrides (defaults shown)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b   # used when the first is busy/rate-limited
# GROQ_STT_MODEL=whisper-large-v3

# ---------------------------------------------------------------------------
# Image model (see backend/ml/classifier.py → MODELS, docs/MODEL_CARD.md)
# ---------------------------------------------------------------------------
# DEFAULT: daksh-mobilenetv2. It has NO Hugging Face repo, but its ONNX export
# is committed to the repo, so a fresh clone works with no download and no
# PyTorch. This is the model the deployed backend uses.
# DHARRAKSHAK_MODEL=daksh-mobilenetv2

# Hugging Face candidates — higher accuracy, but require
# `python scripts/download_model.py` and torch/transformers:
# DHARRAKSHAK_MODEL=linkanjarad-mobilenetv2     # best field accuracy (license not stated)
# DHARRAKSHAK_MODEL=dinov2-small                 # CC-BY-SA-4.0
# DHARRAKSHAK_MODEL=convnext-tiny                # Apache-2.0

# How the legacy model is executed: "onnx" (default, ~15 MB runtime — what the
# free Render plan uses) or "torch" (needs torch + the .pth weights).
# DHARRAKSHAK_RUNTIME=onnx

# ONNX Runtime thread count. render.yaml sets 1 to stay inside 512 MB.
# DHARRAKSHAK_THREADS=2

# Load the model during startup instead of on the first analysis.
# Set to 0 to keep server start fast (the tests do this).
# DHARRAKSHAK_PRELOAD_MODEL=1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# SQLite file. Default: data/dharrakshak.sqlite3
# On Render set this to /tmp/... because the repo filesystem is read-only.
# DHARRAKSHAK_DB=data/dharrakshak.sqlite3

# Extra browser origins allowed by CORS (comma-separated), e.g. a custom
# domain. localhost:5173 and *.vercel.app are always allowed.
# DHARRAKSHAK_CORS_ORIGINS=https://dharrakshak.example.com

# Per-client rate limits on /analyze, /chat and /voice/transcribe.
# Set to 0 to disable (e.g. while load-testing locally).
# DHARRAKSHAK_RATE_LIMIT=1

# ---------------------------------------------------------------------------
# Frontend (these live in frontend/.env — Vite only exposes VITE_* vars)
# ---------------------------------------------------------------------------
# VITE_API_MODE=mock     # "mock" = bundled sample data, no backend needed
# VITE_API_MODE=api      # "api"  = call the FastAPI backend
# VITE_API_BASE=http://localhost:8000   # empty = same origin (Vite proxies /api)
